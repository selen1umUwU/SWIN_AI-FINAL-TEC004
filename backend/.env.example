# Mẫu cấu hình — copy file này thành .env rồi điền giá trị thật.
# KHÔNG bao giờ commit file .env lên GitHub.

# API chính cho chatbot (Google AI Studio)
GEMINI_API_KEY=

# API dự phòng khi Gemini lỗi (openrouter.ai)
OPENROUTER_API_KEY=

# Chuỗi kết nối PostgreSQL trên Neon, dùng để lưu lịch sử chat
DATABASE_URL=

# Đặt =1 để ép Gemini lỗi, dùng khi demo hoặc đo cơ chế failover. Mặc định 0.
FORCE_PRIMARY_FAILURE=0
